# Copia este archivo como .env y ajusta los valores. No subas .env a git.

PORT=8080
NODE_ENV=development

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
# Si usas SQL Server Express con instancia con nombre (p. ej. localhost\SQLEXPRESS),
# deja DB_PORT vacío y pon el nombre aquí (requiere el servicio SQL Server Browser):
DB_INSTANCE=
DB_NAME=SIRA
DB_USER=sira_api_login
DB_PASSWORD=CAMBIA-ESTA-CLAVE-2026!
# En local con el certificado autofirmado de SQL Server: true. En producción: false con certificado válido.
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true

# --- Sesiones y seguridad ---
SESSION_HOURS=12
MAX_FAILED_LOGINS=3
LOCK_MINUTES=30

# Carpeta EN LA MÁQUINA DE SQL SERVER donde se escriben los .bak (debe existir y SQL Server debe poder escribir).
BACKUP_DIR=C:\SIRA\Respaldos

# Solo para el seed de desarrollo (npm run seed:dev). Debe coincidir con DEMO_LOGIN_PASSWORD de la app.
SEED_DEMO_PASSWORD=SiraDemo2026!
